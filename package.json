{
  "name": "fincheck-monorepo",
  "version": "1.0.0",
  "description": "Fincheck - Personal Finance Management Application",
  "scripts": {
    "setup": "./scripts/setup.sh",
    "update:submodules": "./scripts/update-submodules.sh",
    "docker:up": "docker-compose up",
    "docker:up:build": "docker-compose up --build",
